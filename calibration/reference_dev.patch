+/**
+ * Enemy multipliers of one round from the effects the official client lists for it (sceneStateData.globalBattleEffects,
+ * research observed-enemy-effects.json), with the season's own values (effectBuffInfoDataDict): enemy_attribute_mul
+ * max_hp / atk multiply, enemy_attribute_add attack_speed adds (`aspd`, roundMods aspdAdd), env_gbuff_new
+ * enemy_move_speed_mul adds to the move speed; the 补给线 effects' (aceffect_enemy_2*) HP is also `supplyHp`, the share the
+ * 14 器物 keys skip. Measured on 30 live 终极 battles: the engine's own-field leaks against the client's battleStatus went
+ * from r 0.83 (research table) to 0.96 (stronghold-training 方案 §8.15).
+ */
+function observedEnemyScale(act, ids, where) {
+  const rows = act?.effectBuffInfoDataDict || {};
+  let hp = 1, atk = 1, supply = 1, aspd = 0, move = 0;
+  for (const id of ids) {
+    const buffs = rows[id];
+    if (!Array.isArray(buffs)) { warn(`observed enemy effect ${id} (${where}) is not in effectBuffInfoDataDict`); continue; }
+    for (const b of buffs) {
+      const bb = Object.fromEntries((b.blackboard || []).map((x) => [x.key, x.valueStr ?? x.value]));
+      if (b.key === 'enemy_attribute_mul') {
+        if (Number.isFinite(bb.max_hp)) { hp *= bb.max_hp; if (/^aceffect_enemy_2(_\d+)?$/.test(id)) supply *= bb.max_hp; }
+        if (Number.isFinite(bb.atk)) atk *= bb.atk;
+      } else if (b.key === 'enemy_attribute_add' && Number.isFinite(bb.attack_speed)) aspd += bb.attack_speed;
+      else if (b.key === 'env_gbuff_new' && bb.key === 'enemy_move_speed_mul' && Number.isFinite(bb.move_speed)) move += bb.move_speed;
+    }
+  }
+  return { atk: cleanNum(atk), hp: cleanNum(hp), speed: cleanNum(1 + move), ...(aspd ? { aspd } : {}),
+    ...(cleanNum(supply) !== 1 ? { supplyHp: cleanNum(supply) } : {}), observed: true };
+}
